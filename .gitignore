# ---- local runtime (created on first launch, several GB) ----
.venv/
__pycache__/
*.py[cod]
*.log
logs/
cache/

# ---- machine-specific config / install record ----
config.json
安装信息.json

# ---- user data: datasets, models, weights, training runs ----
workspace/

# ---- build artifacts and release binaries ----
# app.ico / splash.png are SOURCE assets (build_setup.py, installer.py and
# build_exe.py need them), so they must stay tracked, not ignored.
build/
dist/
payload.zip
*.spec
*.exe
*.zip

# ---- agent workspace data (not project source) ----
.workbuddy/

# ---- editor / OS ----
.DS_Store
Thumbs.db
.idea/
.vscode/
